

CREATE COMPUTE MODULE MF_Err_Handlr_ErrHandler
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		SET OutputRoot = InputRoot;
		
		CREATE LASTCHILD OF OutputRoot.JSON.Data  NAME 'status';
		SET OutputRoot.JSON.Data.status = 'SUCCESS';
		
		THROW USER EXCEPTION MESSAGE 3001 VALUES ('Customer Validation failed');
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
