

CREATE COMPUTE MODULE MF_ECommerce_Order_Transformation_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- set message properties or header
		SET OutputRoot.Properties =InputRoot.Properties;
		
		-- Header Fields
		-- Great work
		
		CREATE FIELD OutputRoot.JSON.Data.items IDENTITY(JSON.Array)items;

        SET OutputRoot.JSON.Data.orderId = InputRoot.JSON.Data.order.orderId;

        SET OutputRoot.JSON.Data.customerId = InputRoot.JSON.Data.order.customer.customerId;

        SET OutputRoot.JSON.Data.customerName = InputRoot.JSON.Data.order.customer.name;

        SET OutputRoot.JSON.Data.orderTotal = 0;

        DECLARE i INTEGER 1;

FOR inItem AS InputRoot.JSON.Data.order.items.Item[] DO

    SET OutputRoot.JSON.Data.items.Item[i].productCode =
        inItem.product.code;

    SET OutputRoot.JSON.Data.items.Item[i].productName =
        inItem.product.name;

    SET OutputRoot.JSON.Data.items.Item[i].quantity =
        inItem.quantity;

    SET OutputRoot.JSON.Data.items.Item[i].amount =
        inItem.unitPrice * inItem.quantity;

    SET OutputRoot.JSON.Data.orderTotal =
        OutputRoot.JSON.Data.orderTotal
        + (inItem.unitPrice * inItem.quantity);

    SET i = i + 1;

END FOR;        		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
