

CREATE COMPUTE MODULE MF_Order_Amount_Calculation_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
			 
		SET OutputRoot.JSON.Data.orderId     = InputRoot.JSON.Data.orderId;
		SET OutputRoot.JSON.Data.productCode = InputRoot.JSON.Data.productCode;
		SET OutputRoot.JSON.Data.productName = InputRoot.JSON.Data.productName;
		SET OutputRoot.JSON.Data.quantity    = InputRoot.JSON.Data.quantity;
		SET OutputRoot.JSON.Data.totalAmount = InputRoot.JSON.Data.quantity * InputRoot.JSON.Data.unitPrice;
		
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
