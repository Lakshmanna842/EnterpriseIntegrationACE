

CREATE COMPUTE MODULE MF_Customer_Registration_Transformation_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.JSON.Data.customer.id = InputRoot.JSON.Data.customerId;
		SET OutputRoot.JSON.Data.customer.name = InputRoot.JSON.Data.firstName || ' ' || InputRoot.JSON.Data.lastName;
		SET OutputRoot.JSON.Data.customer.location = InputRoot.JSON.Data.city;
		
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
