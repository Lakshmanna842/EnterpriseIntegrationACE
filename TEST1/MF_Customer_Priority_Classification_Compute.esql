

CREATE COMPUTE MODULE MF_Customer_Priority_Classification_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		DECLARE customerType CHARACTER ;
		DECLARE requestAmount INTEGER;
		SET OutputRoot.JSON.Data.requestId     = InputRoot.JSON.Data.requestId;
		SET OutputRoot.JSON.Data.customerId    = InputRoot.JSON.Data.customerId;
		SET OutputRoot.JSON.Data.customerType  = InputRoot.JSON.Data.customerType;
		SET OutputRoot.JSON.Data.requestAmount = InputRoot.JSON.Data.requestAmount;
		
		SET customerType = InputRoot.JSON.Data.customerType;
		SET requestAmount = InputRoot.JSON.Data.requestAmount;
		
		CASE customerType
			
		WHEN 'GOLD' THEN
			IF  requestAmount >= 500000 THEN				
				SET OutputRoot.JSON.Data.priority = 'HIGH';
			ELSE
				SET OutputRoot.JSON.Data.priority = 'NORMAL';
			END IF;
		WHEN 'SILVER' THEN
			IF  requestAmount >= 50000 THEN				
				SET OutputRoot.JSON.Data.priority = 'HIGH';
			ELSE
				SET OutputRoot.JSON.Data.priority = 'NORMAL';
			END IF;			
		ELSE 
			SET OutputRoot.JSON.Data.priority = 'NORMAL';
			
		END CASE;
		
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
